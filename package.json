{
  "name": "@jamashita/dango",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:jamashita/dango.git"
  },
  "license": "MIT",
  "author": "jamashita <jamashita@arachnid.xyz>",
  "type": "module",
  "scripts": {
    "build": "pnpm clean && next build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "clean": "rimraf out && rimraf .next",
    "dev": "next dev",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepare": "is-ci || husky",
    "start": "next start",
    "test": "vitest",
    "update": "pnpm update:upgrade && pnpm update:install",
    "update:install": "pnpm install && pnpm update --latest && pnpm audit --fix",
    "update:upgrade": "ncu --packageManager pnpm --deep --upgrade"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "lint-staged": "17.3.0",
    "npm-check-updates": "23.0.2",
    "postcss": "8.5.26",
    "rimraf": "6.1.3",
    "sort-package-json": "4.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  }
}
